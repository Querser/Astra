{
  "name": "astra-web",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first crew health interface with a Qwen3-8B assistant and AI-assisted visual design.",
  "license": "Apache-2.0",
  "type": "module",
  "astra": {
    "localAiModel": {
      "name": "Qwen3-8B",
      "ollamaTag": "qwen3:8b",
      "weightsBundled": false
    },
    "generativeAiDisclosure": {
      "visualDesignAssisted": true,
      "generatedAssets": [
        "src/assets/astra-anatomy-atlas.png"
      ],
      "disclosureDocument": "../docs/ai-disclosure.md"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.65.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
