# Stage 1 contains no secrets and no remote runtime dependencies.
# Reserve the data location for Stage 2; do not put real health data in the repository.
ASTRA_DATA_DIR=
# Logs are stored in ASTRA_DATA_DIR/logs/astra.jsonl by default.
# Optional explicit SQLite URL, for example: sqlite:///C:/ASTRA/local.sqlite3
ASTRA_DATABASE_URL=
# Default is manual-only. Set to 1 only while developing future source adapters.
ASTRA_ENABLE_AUTOMATED_INGESTION=0
# Optional local-only Ollama adapter configuration for Stage 6.
ASTRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASTRA_OLLAMA_MODEL=qwen3:8b
# Chat asks the loopback model to interpret the local case knowledge, records and calculated trends.
# Set to 0 to use the offline rules only; no health data is sent to a remote host.
ASTRA_CHAT_MODEL_ENABLED=1
# Loopback service locations used by launch and diagnostics scripts.
ASTRA_BACKEND_URL=http://127.0.0.1:8000
ASTRA_FRONTEND_URL=http://127.0.0.1:5173
# Experimental only. Default response is the source-linked calculated overview.
ASTRA_ENABLE_EXPERIMENTAL_LLM=0
